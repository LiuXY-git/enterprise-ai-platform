      "id": "39cc286b-d827-46d1-a39c-ec69fb51d0ec",
      "name": "Normalize Email Request",
      "notes": "Mode = Manual Mapping\nInclude Other Input Fields = 关闭"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const data = item.json;\n\n  const eventId = String(data.event_id ?? '').trim();\n  const requester = String(data.requester ?? '').trim();\n  const subject = String(data.subject ?? '').trim();\n  const body = String(data.body ?? '').trim();\n\n  const text = `${subject}\\n${body}`.trim();\n  const compactText = text.replace(/\\s+/g, ' ');\n  const lowerText = compactText.toLowerCase();\n\n  const rawPriority = String(\n    data.priority ?? 'normal'\n  ).toLowerCase();\n\n  const priority = ['high', 'urgent', 'critical'].includes(\n    rawPriority\n  )\n    ? 'high'\n    : rawPriority === 'low'\n      ? 'low'\n      : 'normal';\n\n  const sensitiveKeywords = [\n    '密码',\n    '密钥',\n    'token',\n    '账号',\n    '退款',\n    '赔偿',\n    '投诉',\n    '法律',\n    '起诉',\n    '隐私',\n    '泄露',\n    '银行卡',\n    '身份证',\n    '删除数据'\n  ];\n\n  const technicalKeywords = [\n    'api',\n    '接口',\n    'http',\n    '502',\n    '500',\n    '错误',\n    '故障',\n    'docker',\n    '容器',\n    '部署',\n    '配置',\n    '性能',\n    '超时',\n    '重启'\n  ];\n\n  const productKeywords = [\n    '文档格式',\n    '上传',\n    '功能',\n    '价格',\n    '支持',\n    '服务',\n    '知识库',\n    '产品'\n  ];\n\n  const vaguePhrases = [\n    '帮我处理',\n    '帮忙看看',\n    '有问题',\n    '不知道怎么办',\n    '尽快处理',\n    '麻烦处理'\n  ];\n\n  const sensitiveKeyword = sensitiveKeywords.find(\n    (keyword) => lowerText.includes(keyword.toLowerCase())\n  );\n\n  const technicalKeyword = technicalKeywords.find(\n    (keyword) => lowerText.includes(keyword.toLowerCase())\n  );\n\n  const productKeyword = productKeywords.find(\n    (keyword) => lowerText.includes(keyword.toLowerCase())\n  );\n\n  const vaguePhrase = vaguePhrases.find(\n    (phrase) => lowerText.includes(phrase)\n  );\n\n  const missingRequired = (\n    !eventId ||\n    !requester ||\n    !subject ||\n    !body\n  );\n\n  const ambiguousRequest = (\n    body.length < 8 ||\n    compactText.length < 12 ||\n    Boolean(vaguePhrase)\n  );\n\n  let category = 'other';\n\n  if (sensitiveKeyword) {\n    category = 'sensitive';\n  }\n  else if (technicalKeyword) {\n    category = 'technical';\n  }\n  else if (productKeyword) {\n    category = 'product';\n  }\n\n  const reviewReasons = [];\n\n  if (missingRequired) {\n    reviewReasons.push('missing_required_fields');\n  }\n\n  if (priority === 'high') {\n    reviewReasons.push('high_priority');\n  }\n\n  if (sensitiveKeyword) {\n    reviewReasons.push(\n      `sensitive_content:${sensitiveKeyword}`\n    );\n  }\n\n  if (ambiguousRequest) {\n    reviewReasons.push('ambiguous_request');\n  }\n\n  const needHumanReview = reviewReasons.length > 0;\n\n  const summary = compactText.length > 120\n    ? `${compactText.slice(0, 117)}...`\n    : compactText;\n\n  return {\n    json: {\n      ...data,\n      accepted: !missingRequired,\n      priority,\n      category,\n      summary,\n      need_human_review: needHumanReview,\n      review_reason: reviewReasons.join(','),\n      next_step: needHumanReview\n        ? 'human_review'\n        : 'ai_draft_generation'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
