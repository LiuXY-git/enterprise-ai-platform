{
  "name": "W6D41 - Workflow Error Handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "4edeb1ff-2d78-41c2-98ae-169825e0ca08",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{\n  \"http://api:8000/workflow-runs/executions/\" +\n  $json.execution.id +\n  \"/failure\"\n}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"error_type\": \"n8n_execution_error\",\n    \"error_message\": String(\n      $json.execution.error.message ||\n      \"n8n workflow execution failed\"\n    ).slice(0, 1000)\n  }\n}}",
        "options": {
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "fd669bca-56a7-4cf3-bf88-726c23cc6045",
      "name": "Persist Workflow Failure",
      "onError": "continueRegularOutput"
    }
  ],
  "pinData": {},
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Persist Workflow Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
