      "workflows/w6d41-persistent-ai-email-assistant.json",
      "workflows/w7d47-sales-followup-assistant.json"
    ],
    "publish_order": [
      "workflows/w6d41-workflow-error-handler.json",
      "workflows/w6d41-persistent-ai-email-assistant.json",
      "workflows/w7d47-sales-followup-assistant.json"
    ],
    "manual_bindings": [
      {
        "workflow": "workflows/w6d41-persistent-ai-email-assistant.json",
        "kind": "error_workflow",
        "setting": "Error Workflow",
        "target": "workflows/w6d41-workflow-error-handler.json"
      },
      {
        "workflow": "workflows/w6d40-daily-workflow-report.json",
        "kind": "credential",
        "node": "DashScope Qwen Chat Model",
        "credential_type": "openAiApi",
        "target": "qwen_credential"
      },
      {
        "workflow": "workflows/w7d47-sales-followup-assistant.json",
        "kind": "credential",
        "node": "DashScope Qwen Chat Model",
        "credential_type": "openAiApi",
        "target": "qwen_credential"
      }
    ],
    "notes": [
      "清单描述目标配置，不会自动导入或发布工作流。导出文件继续保持未激活。",
      "首次部署按 import_order 导入全部文件；按需绑定凭据和 Error Workflow 后，按 publish_order 启用默认发布工作流。",
      "已有实例先核对导出与当前版本；避免重复导入具有相同 Webhook 路径的工作流。",
      "邮件助手必须绑定错误处理工作流；销售助手使用自身 AI/CRM 错误分支，不要求绑定邮件错误处理器。",
      "日报为可选工作流，先检查模型凭据和 Asia/Shanghai 时区，再按需发布调度。参考工作流不默认发布。"
    ]
  },
  "required_environment_variables": [
    "N8N_ENCRYPTION_KEY",
    "DIFY_WORKFLOW_API_KEY"
