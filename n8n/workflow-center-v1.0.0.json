  "deployment": {
    "import_order": [
      "workflows/w6d36-foundation-check.json",
      "workflows/w6d37-customer-request-webhook.json",
      "workflows/w6d38-ai-customer-request.json",
      "workflows/w6d39-ai-email-assistant.json",
      "workflows/w6d40-daily-workflow-report.json",
