  "git_tag": "workflow-center-v1.0.0",
  "runtime_dependencies": {
    "n8n": {
      "compose_service": "n8n",
      "version": "2.36.8",
      "required_environment_variables": [
        "N8N_ENCRYPTION_KEY"
      ]
    },
    "api": {
      "compose_service": "api",
      "base_url": "http://api:8000",
      "version": "1.0.0",
      "required_capabilities": [
        "workflow_runs",
        "crm",
        "analysis_checkpoints",
        "notification_state_apis",
        "centralized_settings",
        "offline_configuration_checks",
        "bounded_workflow_event_logs"
      ]
    },
    "dify": {
      "managed_by_compose": false,
      "configuration_variables": [
        "DIFY_API_BASE_URL"
      ],
      "required_environment_variables": [
        "DIFY_WORKFLOW_API_KEY"
      ],
      "requirement": "可访问的已发布企业咨询工作流；按其配置准备模型及 Knowledge Hub 依赖。"
    },
    "qwen_credential": {
      "storage": "n8n Credential",
      "credential_type": "openAiApi",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen3.7-plus",
      "requirement": "导入后手动选择 DashScope OpenAI 兼容凭据；不从导出文件或 API 容器环境变量自动继承。"
    },
    "sqlite": {
      "managed_by": "api",
      "persistence": "./data",
      "requirement": "启动包含 Day 48 实现的 API，由应用初始化运行账本、CRM 和恢复相关结构。"
    }
  },
  "scope": {
    "sales_notification_mode": "preview",
    "sales_notification_channel": "feishu",
    "notification_failure_validation": "simulated_state_api",
    "sales_live_notification_orchestration": false,
    "feishu_message_api": "implemented_with_prior_live_acceptance",
    "wecom_message_api": "implemented_with_mock_acceptance_live_delivery_pending",
    "limitations": [
      "销售工作流不发送真实消息；飞书独立接口历史真实联调不等于销售通知链路验收。",
      "人工核对通知不会自动把原 failed 运行改成 succeeded，两个状态分别记录。",
      "企业微信真实发送仍等待符合后台准入条件的域名。",
      "当前接口与 Webhook 缺少认证和租户隔离，仅用于本机或可信网络。",
      "日报仍使用固定实验记录；CRM 失败恢复使用显式 replay，不是定时自动重试。",
      "Day 55 本轮真实业务演示与视频验收尚未完成，维护者已安排延期补录。"
    ]
  },
  "optional_integrations": {
