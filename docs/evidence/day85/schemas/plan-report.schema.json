{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1-design",
          "title": "Schema Version",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "adapter_id": {
          "const": "day82_prepare_fixture",
          "title": "Adapter Id",
          "type": "string"
        },
        "mode": {
          "const": "fixture",
          "title": "Mode",
          "type": "string"
        },
        "declared_source_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Declared Source Commit",
          "type": "string"
        },
        "source_sha256_lf": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Source Sha256 Lf",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "agent_id",
        "adapter_id",
        "mode",
        "declared_source_commit",
        "source_sha256_lf"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "enum": [
            "monthly",
            "customer",
            "empty",
            "clarification"
          ],
          "title": "Case",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "normal",
            "tool_timeout_once",
            "tool_timeout_always",
            "model_timeout_once",
            "report_timeout",
            "invalid_report",
            "invalid_arguments"
          ],
          "title": "Scenario",
          "type": "string"
        }
      },
      "required": [
        "case",
        "scenario"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "total_yuan",
            "order_count",
            "customer_id",
            "has_citation",
            "approval_status",
            "simulated_effects",
            "external_send"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "const": "eq",
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        }
      },
      "required": [
        "criterion_id",
        "field",
        "operator",
        "expected"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1-design",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "const": "0.1-design",
          "title": "Dataset Version",
          "type": "string"
        },
        "purpose": {
          "const": "contract_smoke_only",
          "title": "Purpose",
          "type": "string"
        },
        "data_kind": {
          "const": "fictional",
          "title": "Data Kind",
          "type": "string"
        },
        "adapter_id": {
          "const": "day82_prepare_fixture",
          "title": "Adapter Id",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/TestCase"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "dataset_version",
        "purpose",
        "data_kind",
        "adapter_id",
        "cases"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "business_status": {
          "enum": [
            "completed",
            "no_data",
            "needs_clarification",
            "failed",
            "rejected"
          ],
          "title": "Business Status",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "business_status",
        "criteria"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "PlanSummary": {
      "additionalProperties": false,
      "properties": {
        "total_cases": {
          "minimum": 0,
          "title": "Total Cases",
          "type": "integer"
        },
        "not_run": {
          "minimum": 0,
          "title": "Not Run",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "success_rate": {
          "default": null,
          "title": "Success Rate",
          "type": "null"
        }
      },
      "required": [
        "total_cases",
        "not_run"
      ],
      "title": "PlanSummary",
      "type": "object"
    },
    "PlannedResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "execution_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Execution Status",
          "type": "string"
        },
        "judgement": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Judgement",
          "type": "string"
        },
        "observed_business_status": {
          "default": null,
          "title": "Observed Business Status",
          "type": "null"
        },
        "error": {
          "default": null,
          "title": "Error",
          "type": "null"
        },
        "metrics": {
          "$ref": "#/$defs/UnmeasuredMetrics"
        }
      },
      "required": [
        "case_id"
      ],
      "title": "PlannedResult",
      "type": "object"
    },
    "TestCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "task": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/CaseInput"
        },
        "expected": {
          "$ref": "#/$defs/Expectation"
        }
      },
      "required": [
        "case_id",
        "task",
        "input",
        "expected"
      ],
      "title": "TestCase",
      "type": "object"
    },
    "UnmeasuredMetrics": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "default": null,
          "title": "Latency Ms",
          "type": "null"
        },
        "input_tokens": {
          "default": null,
          "title": "Input Tokens",
          "type": "null"
        },
        "output_tokens": {
          "default": null,
          "title": "Output Tokens",
          "type": "null"
        },
        "cost": {
          "default": null,
          "title": "Cost",
          "type": "null"
        },
        "notice": {
          "const": "not_run_not_measured",
          "default": "not_run_not_measured",
          "title": "Notice",
          "type": "string"
        }
      },
      "title": "UnmeasuredMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1-design",
      "title": "Schema Version",
      "type": "string"
    },
    "report_kind": {
      "const": "preflight_plan_not_evaluation",
      "title": "Report Kind",
      "type": "string"
    },
    "execution_status": {
      "const": "not_run",
      "title": "Execution Status",
      "type": "string"
    },
    "agent": {
      "$ref": "#/$defs/AgentSpec"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "agent_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Agent Spec Sha256",
      "type": "string"
    },
    "dataset_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "identity_check": {
      "const": "declared_local_files_only_commit_not_resolved",
      "title": "Identity Check",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/PlannedResult"
      },
      "title": "Rows",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/PlanSummary"
    }
  },
  "required": [
    "schema_version",
    "report_kind",
    "execution_status",
    "agent",
    "dataset",
    "agent_spec_sha256",
    "dataset_sha256",
    "identity_check",
    "rows",
    "summary"
  ],
  "title": "EvaluationPlan",
  "type": "object"
}
