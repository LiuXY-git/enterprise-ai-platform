      "type": "string"
    },
    "mode": {
      "const": "fixture",
      "title": "Mode",
      "type": "string"
    },
    "declared_source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Declared Source Commit",
      "type": "string"
    },
    "source_sha256_lf": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
