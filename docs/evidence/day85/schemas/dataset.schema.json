{
  "$defs": {
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "enum": [
            "monthly",
            "customer",
            "empty",
            "clarification"
          ],
          "title": "Case",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "normal",
            "tool_timeout_once",
            "tool_timeout_always",
            "model_timeout_once",
            "report_timeout",
            "invalid_report",
            "invalid_arguments"
          ],
          "title": "Scenario",
          "type": "string"
        }
      },
      "required": [
        "case",
        "scenario"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "total_yuan",
            "order_count",
            "customer_id",
            "has_citation",
            "approval_status",
            "simulated_effects",
            "external_send"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "const": "eq",
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        }
      },
      "required": [
        "criterion_id",
        "field",
        "operator",
        "expected"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "business_status": {
          "enum": [
            "completed",
            "no_data",
            "needs_clarification",
            "failed",
            "rejected"
          ],
          "title": "Business Status",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "business_status",
        "criteria"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "TestCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "task": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/CaseInput"
        },
        "expected": {
          "$ref": "#/$defs/Expectation"
        }
      },
      "required": [
        "case_id",
        "task",
        "input",
        "expected"
      ],
      "title": "TestCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1-design",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "0.1-design",
      "title": "Dataset Version",
      "type": "string"
    },
    "purpose": {
      "const": "contract_smoke_only",
      "title": "Purpose",
      "type": "string"
    },
    "data_kind": {
      "const": "fictional",
      "title": "Data Kind",
      "type": "string"
    },
    "adapter_id": {
      "const": "day82_prepare_fixture",
      "title": "Adapter Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/TestCase"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "purpose",
    "data_kind",
    "adapter_id",
    "cases"
  ],
  "title": "Dataset",
  "type": "object"
}
