# Day 52: process environment > project .env > code defaults.
# Values are literal (no ${VARIABLE} interpolation in the API loader).
# Restart local API / recreate API container after configuration changes.
# RAG generation only: does not select models inside Dify or n8n.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# Dify -> platform retrieval authentication (separate from workflow key)
DIFY_EXTERNAL_KNOWLEDGE_API_KEY=
DIFY_EXTERNAL_KNOWLEDGE_ID=enterprise-knowledge-hub

# Platform -> Dify workflow; Dify model is configured in the Dify application.
# Container address below; local API may use http://localhost/v1 instead.
DIFY_API_BASE_URL=http://host.docker.internal/v1
DIFY_WORKFLOW_API_KEY=
DIFY_WORKFLOW_TIMEOUT_SECONDS=120

# n8n runtime only; native model keys belong in n8n Credentials.
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_TIMEOUT_SECONDS=10

FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_RECEIVE_ID=
FEISHU_MAX_ATTEMPTS=3
FEISHU_RETRY_BASE_SECONDS=0.5

# WeCom application notifications
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_TO_USER=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_TIMEOUT_SECONDS=10
