FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

ENV PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --create-home app

# Reuse the exact Agent environment. Its Windows-only dependency is marked.
COPY experiments/day73/requirements-lock.txt /tmp/worker-requirements.txt
RUN python -m pip install -r /tmp/worker-requirements.txt && python -m pip check

COPY --chown=app:app backend ./backend
COPY --chown=app:app experiments ./experiments
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app agent-center ./agent-center
COPY --chown=app:app evaluation-center ./evaluation-center
COPY --chown=app:app docs ./docs
COPY --chown=app:app n8n ./n8n
COPY --chown=app:app demo ./demo
COPY --chown=app:app tests ./tests
COPY --chown=app:app requirements.txt requirements-dev.txt pyproject.toml README.md ./
RUN mkdir -p /app/console-data /app/data && chown -R app:app /app/console-data /app/data
USER app
ENV WEB_CONSOLE_DATA_DIR=/app/console-data
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=3 \
    CMD python -B -m backend.app.console.worker --healthcheck
CMD ["python", "-B", "-m", "backend.app.console.worker"]
